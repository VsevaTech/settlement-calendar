# SQLAlchemy database URL. Defaults to a local SQLite file.
SC_DATABASE_URL=sqlite:///./data/settlement_calendar.db

# Pins the "today" used for status calculation (YYYY-MM-DD).
# Leave empty in real usage - the app then uses the real current date.
# The bundled demo dataset is anchored to 2026-09-17, so keep this value
# to reproduce the documented demo numbers.
SC_AS_OF_DATE=2026-09-17

# Weekend days as ISO weekday numbers (Mon=1 ... Sun=7), comma separated.
SC_WEEKEND_DAYS=6,7
